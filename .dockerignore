# ============================================
# Docker 构建上下文
# 生产镜像只接收运行与构建所需文件，文档和测量证据不得使应用层缓存失效。
# ============================================

# 依赖（安装成本最低）
node_modules

# 构建输出（重新生成）
.next
out
coverage

# 版本控制
.git
.github
.DS_Store

# 仓库协作、测试与性能证据（不进入生产镜像）
.claude
.codex
.gstack
.payload
.ruff_cache
__tests__
docs
perf
output
graphify-out
README.md
CLAUDE.md
AGENTS.md
DESIGN.md
SECURITY.md
TESTING_GUIDE.md
*.tsbuildinfo
cookies.txt
resume

# 敏感环境变量（安全关键；服务端构建目录含 .env.docker.prod）
.env*
.npmrc

# 日志
*.log
logs/

# 上传文件（运行时挂载）
media/
uploads/
