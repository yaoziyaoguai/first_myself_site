# Local development. Copy to .env.local and replace every placeholder.

DATABASE_URL=postgresql://payload:change-me@localhost:5432/first_myself_site
PAYLOAD_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Development-only initialization endpoints. Leave blank when unused.
ADMIN_SECRET_TOKEN=
PAYLOAD_INITIAL_ADMIN_EMAIL=
PAYLOAD_INITIAL_ADMIN_PASSWORD=

NODE_ENV=development

# Per-article Blog Agent. All values are server-only; keep both switches off
# until the provider canary and abuse checks have passed.
BLOG_AGENT_ENABLED=false
BLOG_AGENT_GENERATION_ENABLED=false
BLOG_AGENT_BASE_URL=
BLOG_AGENT_API_KEY=
BLOG_AGENT_MODEL=
BLOG_AGENT_MODEL_TIMEOUT_MS=15000
BLOG_AGENT_CACHE_TTL_SECONDS=86400
BLOG_AGENT_WINDOW_LIMIT=3
BLOG_AGENT_WINDOW_SECONDS=600
BLOG_AGENT_IDENTITY_DAILY_LIMIT=20
BLOG_AGENT_GLOBAL_DAILY_LIMIT=100
BLOG_AGENT_IDENTITY_CONCURRENCY=1
BLOG_AGENT_GLOBAL_CONCURRENCY=3
