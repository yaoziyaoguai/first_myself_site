# ============================================
# 生产环境环境变量模板 (Docker)
# 放置位置: 仓库根目录
#
# 使用方法:
# 1. cp .env.docker.prod.example .env.docker.prod
# 2. 编辑 .env.docker.prod，填入真实生产值
# 3. 确保 .env.docker.prod 已加入 .gitignore（不应提交）
#
# 警告: 此文件包含生产敏感信息，切勿提交到 Git！
# ============================================

# -------------------------------------------------
# 数据库配置 (Docker PostgreSQL)
# -------------------------------------------------
POSTGRES_DB=first_myself_site_prod
POSTGRES_USER=payload_prod
# 强随机密码（建议 32 位以上）
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_RANDOM_PASSWORD

# -------------------------------------------------
# Payload CMS 安全密钥
# 生成命令: openssl rand -base64 32
# -------------------------------------------------
PAYLOAD_SECRET=CHANGE_THIS_TO_GENERATED_SECRET

# -------------------------------------------------
# 公共 URL（Next.js 构建时内联到客户端）
# 警告: 修改此值后必须重新构建镜像
# -------------------------------------------------
NEXT_PUBLIC_SERVER_URL=https://wangjinkun333.me

# -------------------------------------------------
# 单文章 Blog Agent（全部为服务端变量）
# 首次部署保持两个开关为 false，canary 与安全检查通过后再开启。
# API Key 使用供应商侧单独创建的低额度密钥，绝不能提交到 Git。
# -------------------------------------------------
BLOG_AGENT_ENABLED=false
BLOG_AGENT_GENERATION_ENABLED=false
BLOG_AGENT_BASE_URL=
BLOG_AGENT_API_KEY=
BLOG_AGENT_MODEL=
BLOG_AGENT_MODEL_TIMEOUT_MS=15000
BLOG_AGENT_CACHE_TTL_SECONDS=86400
BLOG_AGENT_WINDOW_LIMIT=3
BLOG_AGENT_WINDOW_SECONDS=600
BLOG_AGENT_IDENTITY_DAILY_LIMIT=20
BLOG_AGENT_GLOBAL_DAILY_LIMIT=100
BLOG_AGENT_IDENTITY_CONCURRENCY=1
BLOG_AGENT_GLOBAL_CONCURRENCY=3
